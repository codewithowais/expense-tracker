# ─────────────────────────────────────────────────────────────
# Ledgerly cloud sync (optional). Leave DATABASE_URL blank to run
# fully offline — the app always works local-first without this.
# ─────────────────────────────────────────────────────────────

# Neon Postgres connection string. Get one by running:
#   npx neonctl@latest init
# then copy the *pooled* connection string it prints (starts with
# postgresql://...  and usually contains "-pooler").
# This is read ONLY on the server and is never exposed to the browser.
DATABASE_URL=

# App lock PIN. When set, the app REQUIRES this PIN to unlock on every device.
# It is validated only on the server (never shipped to the browser), and is the
# same everywhere your deployment runs — change it here and redeploy to change
# the PIN on web and mobile at once. Leave blank to disable the lock.
APP_PIN=1234

# Optional shared secret to protect the /api/sync endpoint from anonymous
# writes. If you set SYNC_SECRET, also set NEXT_PUBLIC_SYNC_TOKEN to the SAME
# value so the app can authenticate. Leave both blank to disable the check.
# NOTE: NEXT_PUBLIC_ vars are visible in the browser bundle, so this is a light
# guard, not strong auth — for real privacy, protect the deployment itself.
SYNC_SECRET=
NEXT_PUBLIC_SYNC_TOKEN=
