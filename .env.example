# ─────────────────────────────────────────────────────────────
# Ledgerly — multi-tenant accounts (Better Auth) + cloud sync
# ─────────────────────────────────────────────────────────────

# Neon Postgres connection string (server-only; never exposed to the browser).
# Get one with:  npx neonctl@latest init  — use the *pooled* string ("-pooler").
# Holds the Better Auth tables (user/session/account/verification) and the
# per-user synced ledger (sync_records). Run migrations after setting it:
#   node scripts/migrate.mjs --fresh        # app tables (user-scoped sync_records)
#   npx @better-auth/cli@latest migrate     # Better Auth tables
DATABASE_URL=

# Better Auth session-signing secret (REQUIRED). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be the SAME value across all instances of a deployment.
BETTER_AUTH_SECRET=

# The canonical origin the app is served from (used for cookies + callbacks).
#   local dev:   http://localhost:3000
#   production:  https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# The email that becomes the super-admin on sign-up (sees all users, can view
# any ledger read-only, manages the signup allowlist + invites, deactivates).
ADMIN_EMAIL=

# Google Gemini API key (OPTIONAL) — enables the in-app AI finance assistant.
# Free key from https://aistudio.google.com/apikey (starts with "AIza…").
# Leave blank to hide the assistant entirely.
GEMINI_API_KEY=

# NOTE: the old single-user vars (APP_PIN, SYNC_SECRET, NEXT_PUBLIC_SYNC_TOKEN)
# are no longer used — the PIN is now per-user and sync is authenticated by the
# signed-in session.
